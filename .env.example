# TeamLens Environment Configuration
# Copy this file to .env and fill in real values

# =============================================================================
# PostgreSQL Database
# =============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=teamlens
DATABASE_PASSWORD=teamlens_dev
DATABASE_NAME=teamlens_dev

# Or use connection string (preferred for Prisma)
DATABASE_URL=postgresql://teamlens:teamlens_dev@localhost:5432/teamlens_dev?schema=public

# =============================================================================
# JWT Authentication
# =============================================================================
# MUST be same across all services (backend, ws, alert-service)
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_ACCESS_TTL=30d
JWT_AGENT_TTL=30d

# =============================================================================
# Application URLs
# =============================================================================
WEB_APP_URL=https://test.teamlens.co
API_BASE_URL=https://api.teamlens.co

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://test.teamlens.co,https://api.teamlens.co

# =============================================================================
# File Uploads
# =============================================================================
UPLOAD_DIR=/app/uploads

# =============================================================================
# WebRTC / TURN Server
# =============================================================================
# TURN server for WebRTC relay (used when direct peer-to-peer fails)
TURN_SERVER_HOST=turn.teamlens.co
TURN_SERVER_PORT=3478
TURN_SERVER_USERNAME=teamlens
TURN_SERVER_PASSWORD=change_turn_password_here

# ICE servers config (JSON array, used by WS service)
WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302","turn:turn.teamlens.co:3478"],"username":"teamlens","credential":"change_turn_password_here"}]

# =============================================================================
# External Services — Analytics & Monitoring
# =============================================================================

# PostHog (Product Analytics + Feature Flags)
# Sign up at https://app.posthog.com, create project, copy API key
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key_here        # Frontend uses this
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com              # Frontend uses this
POSTHOG_API_KEY=phc_your_project_api_key_here                # Backend server-side uses this
POSTHOG_HOST=https://us.posthog.com                          # Backend server-side uses this

# Sentry (Error Tracking)
# Frontend: create Next.js project at https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://your_public_key@o12345.ingest.sentry.io/project_id
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=teamlens-frontend

# Backend: can reuse frontend DSN or create a separate Go project
SENTRY_DSN=https://your_public_key@o12345.ingest.sentry.io/project_id
SENTRY_ENVIRONMENT=development

# =============================================================================
# Cloudflare AI (Screenshot Analysis)
# =============================================================================
CLOUDFLARE_API_KEY=your_cloudflare_api_key
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# =============================================================================
# Gemini / Google AI
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key

# =============================================================================
# Hugging Face (for AI models)
# =============================================================================
HF_TOKEN=your_huggingface_token

# =============================================================================
# Invite System
# =============================================================================
INVITE_TTL_HOURS=72

# =============================================================================
# Ports (for local development)
# =============================================================================
PORT=5000            # Go backend
WS_PORT=4001         # WebSocket service
FRONTEND_PORT=3000   # Next.js frontend
ALERT_HTTP_PORT=8082 # Alert service HTTP
ALERT_GRPC_PORT=50052 # Alert service gRPC

# =============================================================================
# Development Only
# =============================================================================
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
